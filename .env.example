# Backend Environment Variables
DATABASE_URL=sqlite:///./backend/grambiz.db
SECRET_KEY=grambiz_secret_key_demo_2026
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Google Maps API Credentials (Optional - System runs OpenStreetMap engine fallback if omitted)
GOOGLE_MAPS_API_KEY=

# Optional External AI Credentials (System runs deterministic fallback if omitted)
AI_API_KEY=your_groq_api_key_here
GROQ_API_KEY=your_groq_api_key_here
AI_MODEL=qwen/qwen3.8-27b

# Frontend Environment Variables
VITE_API_URL=/api
VITE_APP_NAME="GramBiz AI"
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
